PORT=3000
NODE_ENV=development
JWT_SECRET=rentra_super_secret_jwt_key_2026

# ====================================================================
# MONGODB ATLAS CLUSTER & CUSTOM DATABASE NAME CONFIGURATION
# ====================================================================
# Step 1: Paste your MongoDB Atlas Cluster URL (or local MongoDB URL)
# Example: MONGO_URL=mongodb+srv://admin:password123@cluster0.mongodb.net
MONGO_URL=

# Step 2: Set your custom database name (MongoDB creates this database automatically!)
# Example: MONGO_DB_NAME=my_custom_rentra_db
MONGO_DB_NAME=rentra_db

# Alternative: Full Connection URI String (if preferred)
MONGO_URI=

# Redis Cache & Token Blacklist
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Socket.IO Real-Time Engine
SOCKET_CORS_ORIGIN=http://localhost:5173


# Razorpay Escrow & Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cloudinary Media Storage Pipeline
CLOUDINARY_CLOUD_NAME=rentra-assets
